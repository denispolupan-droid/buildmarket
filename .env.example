# Змінні середовища FIXLINE (buildmarket). Скопіюй у .env.local і заповни.
# Значень тут немає й бути не може: .env.local у .gitignore, прод — Vercel env.
# Токени інтеграцій (НП, Prom, Rozetka, Епіцентр, Mono, NovaPay, Google Ads)
# живуть НЕ тут, а в Supabase Vault (lib/secrets, міграція 150) і задаються
# з адмінки «Налаштування». Нижче лише те, що читає process.env.

# ── Supabase (обов'язково) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management API (міграції, типи, логи) — лише локально/CI, не у Vercel
SUPABASE_ACCESS_TOKEN=

# ── Сайт ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fixline.com.ua
NEXT_PUBLIC_GA_ID=
# Пошта: Resend з верифікованим доменом; RESEND_FROM_EMAIL — адреса відправника
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Куди йдуть службові листи (заявки B2B, помилки)
ADMIN_EMAIL=

# ── Секрети маршрутів ─────────────────────────────────────────────────────
# Авторизація кронів Vercel (lib/cron-auth); ротовано 31.10.2026
CRON_SECRET=
# Підпис URL товарних фідів (Prom/Rozetka/Merchant)
FEED_SECRET_KEY=
# POST /api/revalidate
REVALIDATE_SECRET=
# Вебхук Monobank (підпис ECDSA перевіряє lib/mono-signature)
MONO_WEBHOOK_SECRET=

# ── Нова Пошта ───────────────────────────────────────────────────────────
# Ключ API — у Vault (np_api_key). Відправник — теж у app_settings (np_sender_*);
# ці змінні лишились як запасні й порожніми бути можуть.
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=

# ── Реквізити продавця у документах (lib/company) ─────────────────────────
BANK_RECIPIENT=
BANK_IBAN=
BANK_NAME=
BANK_EDRPOU=
BANK_ADDRESS=
SELLER_CITY=
SIGNATORY_NAME=

# ── Monobank ─────────────────────────────────────────────────────────────
# Виписка ФОП (крон mono-statement) та автозарахування оплат
MONOBANK_API_TOKEN=
MONOBANK_PERSONAL_TOKEN=

# ── Telegram (алерти, дайджест, бот) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Zoho Mail (пошта в адмінці, реєстри виплат з листів) ─────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# ── Cloudflare R2 (фото товарів) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── Бекапи БД (workflow backup-db-full → R2 з object-lock, docs/RESTORE.md) ──
BACKUP_PASSPHRASE=
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# ── Google ───────────────────────────────────────────────────────────────
# Service account JSON (одним рядком) для Search Console; Ads — у Vault
GSC_SERVICE_ACCOUNT_KEY=
# Chrome UX Report API (сторож показників)
CRUX_API_KEY=

# ── ШІ (чернетки відповідей, заведення товарів, дайджест) ────────────────
ANTHROPIC_API_KEY=

# ── Тести ────────────────────────────────────────────────────────────────
# Інтеграційні тести ходять у ТЕСТОВУ базу: окремий файл .env.test з тими ж
# ключами Supabase проєкту test (lib/test-db-guard не пустить у прод).
# Playwright: оптовий акаунт для /catalog під авторизацією
E2E_WHOLESALE_EMAIL=
E2E_WHOLESALE_PASSWORD=
E2E_BASE_URL=http://localhost:3000
