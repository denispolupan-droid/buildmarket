# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
catalog-export.xlsx
# Generated/exported spreadsheets and Excel lock files — regenerable, not source
export-products-*.xlsx
products-template.xlsx
~$*
.claude/settings.local.json
.claude/scheduled_tasks.lock
fixline-audit.zip
lint-new.txt

# local image backups from one-off scripts (not meant to be committed)
scripts/supabase/.image-backup/

# artefacts of one-off script runs — a record of what a migration did on one
# machine at one moment, not source. The scripts themselves are committed.
scripts/supabase/*-report*.json
scripts/supabase/*-report*.md
scripts/supabase/*-backup*.json
scripts/supabase/*.backup*.json
scripts/supabase/*-progress.log

# playwright — .auth holds a live wholesale session, never commit it
tests/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/

# supabase CLI — службовий стан зв'язку з проєктом, не джерельний код
supabase/.temp/

# перевірочні збірки в окремий каталог (NEXT_DIST_DIR), щоб не чіпати dev-сервер
/.next-*/
